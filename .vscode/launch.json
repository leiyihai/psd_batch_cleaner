{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python：自动回归测试",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python：串行批处理",
            "module": "prototype.batch",
            "args": ["--input", "${input:inputDirectory}", "--output", "${input:outputDirectory}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "extendscript-debug",
            "request": "attach",
            "name": "历史 JSX：附加到 Photoshop"
        },
        {
            "type": "extendscript-debug",
            "request": "launch",
            "name": "历史 JSX：运行当前文档清理",
            "script": "${workspaceFolder}/legacy/photoshop/PsDeepCleanerPlus.jsx"
        }
    ],
    "inputs": [
        {"id": "inputDirectory", "type": "promptString", "description": "输入目录（请先备份素材）"},
        {"id": "outputDirectory", "type": "promptString", "description": "独立输出目录（不得与输入目录相互包含）"}
    ]
}
